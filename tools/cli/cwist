FORMAT = "cwist-project/v1"


def fail(message: str) -> None:
    raise SystemExit(f"cwist: {message}")


def write_new_project(name: str, directory: Path | None) -> None:
    if not re.fullmatch(r"[A-Za-z][A-Za-z0-9_-]*", name):
        fail("project name must start with a letter and contain only letters, digits, _ or -")
    root = (directory or Path.cwd()) / name
    if root.exists():
        fail(f"destination already exists: {root}")
    root.mkdir(parents=True)
    project = {
        "format": FORMAT,
        "name": name,
        "version": "0.1.0",
        "language": "c",
        "entrypoint": "src/main.c",
        "build": {"command": "make", "binary": f"bin/{name}"},
        "dev": {"command": f"./bin/{name}", "debounce_ms": 150, "stop_timeout_ms": 5000},
        "dependencies": {"cwist": ">=0.1.0"},
        "openapi": {"source": "src", "output": "openapi.json", "title": name, "version": "0.1.0"},
    }
    (root / f"{name}.cwpro").write_text(json.dumps(project, indent=2) + "\n", encoding="utf-8")
    (root / "src").mkdir()
    (root / "bin").mkdir()
    (root / ".gitignore").write_text("bin/\nopenapi.json\n", encoding="utf-8")
    (root / "Makefile").write_text(
        f"CC ?= cc\nCFLAGS ?= -std=c17 -Wall -Wextra\nTARGET = bin/{name}\n\n"
        "$(TARGET): src/main.c\n\tmkdir -p bin\n\t$(CC) $(CFLAGS) -o $@ $< -lcwist -lpthread\n\n"
        "openapi:\n\tcwist openapi src --project *.cwpro\n\nclean:\n\trm -f $(TARGET)\n",
        encoding="utf-8",
    )
    (root / "src" / "main.c").write_text(
        "#include <cwist/sys/app/app.h>\n#include <cwist/openapi.h>\n\n"
        "static void health(cwist_http_request *req, cwist_http_response *res) {\n"
        "    (void)req;\n    cwist_sstring_assign(res->body, \"{\\\"status\\\":\\\"ok\\\"}\");\n"
        "    cwist_http_header_add(&res->headers, \"Content-Type\", \"application/json\");\n}\n\n"
        "int main(void) {\n    cwist_app *app = cwist_app_create();\n"
        "    /** @openapi.summary Service health\n     * @openapi.tags system\n     * @openapi.response 200 application/json Service status. */\n"
        "    CWIST_OPENAPI_GET(app, \"/health\", health);\n"
        "    int rc = cwist_app_listen(app, 8080);\n    cwist_app_destroy(app);\n    return rc;\n}\n",
        encoding="utf-8",
    )
    print(f"created {root}")


def clean_comment(text: str) -> list[str]:
    body = re.sub(r"^/\*\*?|\*/$", "", text.strip(), flags=re.S)
    return [re.sub(r"^\s*\*?\s?", "", line).strip() for line in body.splitlines()]


def operation_from_comment(comment: str) -> dict:
    operation: dict = {"responses": {"200": {"description": "Success"}}}
    for line in clean_comment(comment):
        match = re.match(r"@openapi\.([a-z_]+)\s+(.+)$", line)
        if not match:
            continue
        key, value = match.groups()
        if key == "summary": operation["summary"] = value
        elif key == "description": operation["description"] = value
        elif key == "operation_id": operation["operationId"] = value
        elif key == "tags": operation["tags"] = [tag.strip() for tag in value.split(",") if tag.strip()]
        elif key == "response":
            parts = value.split(None, 2)
            if not parts or not parts[0].isdigit():
                fail(f"invalid @openapi.response: {value}")
            response = {"description": parts[2] if len(parts) == 3 else "Response"}
            if len(parts) >= 2 and "/" in parts[1]: response["content"] = {parts[1]: {"schema": {"type": "object"}}}
            operation["responses"][parts[0]] = response
    return operation


def source_files(source: Path) -> list[Path]:
    return [source] if source.is_file() else sorted(source.rglob("*.c"))


# Allocation/synchronization call sites, grouped by category and by which
# convention they follow:
#   cwist -- routed through cwist's own wrapper (visible to cwist_full_gc()
#            for alloc; libttak's portable primitive for pthread)
#   gnu   -- the raw glibc/POSIX call, bypassing that wrapper
#   bsd   -- a BSD-origin idiom (reallocarray/strlcpy/strlcat/explicit_bzero,
#            or a BSD-flavored pthread_np variant) used directly
# A line matching none of these is simply not an allocation/sync call site.
AUDIT_PATTERNS: dict[str, dict[str, str]] = {
    "alloc": {
        "cwist": r"\bcwist_(?:malloc|alloc(?:_array|_scoped)?|realloc|strn?dup|free|ebr_alloc|ebr_free)\s*\(|\bCWIST_DEFER_FREE\b",
        "gnu": r"\b(?:malloc|calloc|realloc|free|strn?dup)\s*\(",
        "bsd": r"\b(?:reallocarray|strlcpy|strlcat|explicit_bzero|freezero)\s*\(",
    },
    "pthread": {
        "cwist": r"\bttak_(?:mutex|cond|rwlock|thread)_\w+\s*\(",
        "gnu": r"\bpthread_(?:create|join|detach|mutex_\w+|cond_\w+|rwlock_\w+|key_\w+|once\w*|attr_\w+)\s*\(",
        "bsd": r"\bpthread_set_name_np\s*\(",
    },
}


def audit_sources(source: Path, category: str, style: str) -> list[tuple[str, int, str, str, str]]:
    """Return (file, line, category, style, snippet) for every allocation/
    sync call site under `source` matching `category`/`style` ("all" for
    either means no filter). `source` may be a file or a directory, and
    relative, absolute, or `~`-prefixed; directories are scanned
    recursively (source_files() -> Path.rglob("*.c"))."""
    source = source.expanduser().resolve()
    if not source.exists():
        fail(f"no such file or directory: {source}")
    categories = AUDIT_PATTERNS if category == "all" else {category: AUDIT_PATTERNS[category]}
    compiled = {
        cat: {sty: re.compile(pat) for sty, pat in styles.items() if style in ("all", sty)}
        for cat, styles in categories.items()
    }
    rows: list[tuple[str, int, str, str, str]] = []
    for file in source_files(source):
        try:
            lines = file.read_text(encoding="utf-8", errors="replace").splitlines()
        except OSError:
            continue
        for lineno, line in enumerate(lines, start=1):
            stripped = line.strip()
            if stripped.startswith(("//", "*", "/*")):
                continue
            for cat, styles in compiled.items():
                for sty, pattern in styles.items():
                    m = pattern.search(line)
                    if m:
                        rows.append((str(file), lineno, cat, sty, stripped[:100]))
    return rows


AUDIT_QUERY_KEYS = {
    "style": "style",
    "category": "category",
    "cat": "category",
    "folder": "path",
    "path": "path",
    "json": "json",
}


def parse_audit_query(raw: str) -> dict[str, str]:
    """Parse `cwist audit`'s one-string query form:
    open="style:bsd;folder:./src/net" (the leading `open=` and surrounding
    quotes are optional -- the shell strips the quotes either way; `open=`
    is accepted so the form in the docs/examples runs verbatim). Segments
    are `;`-separated `key:value` pairs; recognized keys: style, category
    (or cat), folder (or path), json. Unknown keys are rejected so a typo
    doesn't silently no-op."""
    text = raw.strip()
    if text.startswith("open="):
        text = text[len("open="):]
    text = text.strip().strip('"').strip("'")
    result: dict[str, str] = {}
    for segment in filter(None, (s.strip() for s in text.split(";"))):
        if ":" not in segment:
            fail(f"audit query segment missing ':': {segment!r} (expected key:value)")
        key, value = segment.split(":", 1)
        key = key.strip().lower()
        if key not in AUDIT_QUERY_KEYS:
            fail(f"unknown audit query key {key!r} (expected one of: {', '.join(sorted(set(AUDIT_QUERY_KEYS)))})")
        result[AUDIT_QUERY_KEYS[key]] = value.strip()
    return result


def looks_like_audit_query(raw: str) -> bool:
    if raw.startswith("open="):
        return True
    head = raw.split(";", 1)[0].split(":", 1)[0].strip().lower()
    return head in AUDIT_QUERY_KEYS


def display_path(path: str) -> str:
    p = Path(path)
    try:
        return str(p.relative_to(Path.cwd()))
    except ValueError:
        return str(p)


def run_audit(source: Path, category: str, style: str, as_json: bool) -> None:
    rows = audit_sources(source, category, style)
    rows = [(display_path(f), ln, cat, sty, snip) for f, ln, cat, sty, snip in rows]
    if as_json:
        print(json.dumps([
            {"file": f, "line": ln, "category": cat, "style": sty, "snippet": snip}
            for f, ln, cat, sty, snip in rows
        ], indent=2))
        return
    if not rows:
        print("no matching allocation/sync call sites found")
        return
    width = max(len(f"{f}:{ln}") for f, ln, *_ in rows)
    for f, ln, cat, sty, snip in rows:
        loc = f"{f}:{ln}"
        print(f"{loc:<{width}}  {cat:<8} {sty:<6} {snip}")
    counts: dict[tuple[str, str], int] = {}
    for _, _, cat, sty, _ in rows:
        counts[(cat, sty)] = counts.get((cat, sty), 0) + 1
    print()
    print("summary:")
    for (cat, sty), n in sorted(counts.items()):
        print(f"  {cat:<8} {sty:<6} {n}")


def generate_openapi(source: Path, output: Path, title: str, version: str) -> None:
    route_re = re.compile(r"CWIST_OPENAPI_(GET|POST|PUT|DELETE|PATCH)\s*\(\s*[^,]+,\s*\"([^\"]+)\"")
    comment_re = re.compile(r"/\*\*.*?\*/", re.S)
    paths: dict = {}
    for file in source_files(source):
        text = file.read_text(encoding="utf-8")
        comments = list(comment_re.finditer(text))
        for route in route_re.finditer(text):
            preceding = [comment for comment in comments if comment.end() <= route.start()]
            doc = preceding[-1].group(0) if preceding else ""
            operation = operation_from_comment(doc) if "@openapi." in doc else {"responses": {"200": {"description": "Success"}}}
            method, raw_path = route.groups()
            path = re.sub(r":([A-Za-z_][A-Za-z0-9_]*)", r"{\1}", raw_path)
            params = re.findall(r"\{([^}]+)\}", path)
            if params:
                operation["parameters"] = [{"name": p, "in": "path", "required": True, "schema": {"type": "string"}} for p in params]
            paths.setdefault(path, {})[method.lower()] = operation
    document = {"openapi": "3.1.0", "info": {"title": title, "version": version}, "paths": paths}
    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_text(json.dumps(document, indent=2) + "\n", encoding="utf-8")
    print(f"wrote {output} ({len(paths)} paths)")


PROTO_SCALAR = {
    # proto type -> (C type, writer helper, zigzag)
    "bool": ("int", "cwist_pb_write_bool_field", False),
    "int32": ("int64_t", "cwist_pb_write_int64_field", False),
    "int64": ("int64_t", "cwist_pb_write_int64_field", False),
    "uint32": ("uint64_t", "cwist_pb_write_uint64_field", False),
    "uint64": ("uint64_t", "cwist_pb_write_uint64_field", False),
    "sint32": ("int64_t", "cwist_pb_write_int64_field", True),
    "sint64": ("int64_t", "cwist_pb_write_int64_field", True),
    "string": ("const char *", "cwist_pb_write_string_field", False),
    "fixed32": ("uint32_t", "cwist_pb_write_fixed32_field", False),
    "fixed64": ("uint64_t", "cwist_pb_write_fixed64_field", False),
    "sfixed32": ("int32_t", "cwist_pb_write_fixed32_field", False),
    "sfixed64": ("int64_t", "cwist_pb_write_fixed64_field", False),
    "float": ("float", "cwist_pb_write_float_field", False),
    "double": ("double", "cwist_pb_write_double_field", False),
}

PROTO_WIRE = {
    # proto scalar type -> wire shape (anything absent is a varint)
    "string": "len",
    "fixed32": "32", "sfixed32": "32", "float": "32",
    "fixed64": "64", "sfixed64": "64", "double": "64",
}

PROTO_FIELD_RE = re.compile(
    r"\b(?:(repeated|optional|required)\s+)?([\w.]+)\s+(\w+)\s*=\s*(\d+)\s*(?:\[[^\]]*\])?\s*;")
PROTO_MAP_RE = re.compile(
    r"\bmap\s*<\s*([\w.]+)\s*,\s*([\w.]+)\s*>\s*(\w+)\s*=\s*(\d+)\s*(?:\[[^\]]*\])?\s*;")


def _proto_block_spans(text: str, keyword: str) -> list[tuple[str, str, int, int]]:
    """Yield (name, body, start, end) for each `keyword Name { ... }` with balanced braces."""
    blocks = []
    for match in re.finditer(rf"\b{keyword}\s+(\w+)\s*\{{", text):
        depth, pos = 1, match.end()
        while pos < len(text) and depth:
            if text[pos] == "{": depth += 1
            elif text[pos] == "}": depth -= 1
            pos += 1
        if depth:
            fail(f"unbalanced braces in {keyword} {match.group(1)}")
        blocks.append((match.group(1), text[match.end():pos - 1], match.start(), pos))
    return blocks


def _proto_blocks(text: str, keyword: str) -> list[tuple[str, str]]:
    """Yield (name, body) for each `keyword Name { ... }` with balanced braces."""
    return [(name, body) for name, body, _, _ in _proto_block_spans(text, keyword)]


def _strip_proto_comments(text: str) -> str:
    text = re.sub(r"//[^\n]*", "", text)
    return re.sub(r"/\*.*?\*/", "", text, flags=re.S)


def _gen_scalar_encode(field: str, typ: str, value: str) -> str:
    writer, zigzag = PROTO_SCALAR[typ][1], PROTO_SCALAR[typ][2]
    if zigzag:
        return f"if ({writer}(w, {field}, (int64_t)cwist_pb_zigzag_encode({value})) != 0) return -1;"
    return f"if ({writer}(w, {field}, {value}) != 0) return -1;"


def _model_from_proto_text(text: str) -> tuple:
    """Parse proto source text into (package, enums, messages, services)."""
    text = _strip_proto_comments(text)
    package = re.search(r"\bpackage\s+([A-Za-z_][\w.]*)\s*;", text)
    package_name = package.group(1) if package else "proto"

    enums: list[tuple[str, list[tuple[str, int]]]] = []
    for name, body in _proto_blocks(text, "enum"):
        values = [(v, int(n)) for v, n in re.findall(r"(\w+)\s*=\s*(-?\d+)\s*;", body)]
        enums.append((name, values))
    enum_names = {name for name, _ in enums}

    raw_messages = _proto_blocks(text, "message")
    message_names = {name for name, _ in raw_messages}

    def classify(typ: str) -> str:
        return ("scalar" if typ in PROTO_SCALAR else
                "enum" if typ in enum_names else
                "message" if typ in message_names else "unsupported")

    def parse_field(typ: str, field: str, number: str, repeated: bool, oneof: str | None = None) -> dict:
        typ = typ.split(".")[-1]
        return {"type": typ, "name": field, "number": int(number),
                "repeated": repeated, "kind": classify(typ), "oneof": oneof}

    messages: list[tuple[str, list[dict]]] = []
    for name, body in raw_messages:
        located: list[tuple[int, dict]] = []
        spans: list[tuple[int, int]] = []
        for oname, obody, ostart, oend in _proto_block_spans(body, "oneof"):
            spans.append((ostart, oend))
            for label, typ, field, number in PROTO_FIELD_RE.findall(obody):
                located.append((ostart, parse_field(typ, field, number, label == "repeated", oneof=oname)))
        for start, end in sorted(spans, reverse=True):
            body = body[:start] + " " * (end - start) + body[end:]
        map_spans = []
        for match in PROTO_MAP_RE.finditer(body):
            ktyp, vtyp, field, number = match.groups()
            ktyp, vtyp = ktyp.split(".")[-1], vtyp.split(".")[-1]
            key_kind, val_kind = classify(ktyp), classify(vtyp)
            entry = "".join(part.capitalize() for part in field.split("_")) + "Entry"
            f = {"type": f"map<{ktyp},{vtyp}>", "name": field, "number": int(number),
                 "repeated": False, "oneof": None, "entry": entry,
                 "key_type": ktyp, "val_type": vtyp, "key_kind": key_kind, "val_kind": val_kind,
                 # map keys may only be integral scalars, bool, or string
                 "kind": ("map" if key_kind == "scalar" and
                          ktyp not in ("float", "double", "fixed32", "fixed64", "sfixed32", "sfixed64")
                          and val_kind != "unsupported" else "unsupported")}
            located.append((match.start(), f))
            map_spans.append(match.span())
        for start, end in sorted(map_spans, reverse=True):
            body = body[:start] + " " * (end - start) + body[end:]
        for match in PROTO_FIELD_RE.finditer(body):
            label, typ, field, number = match.groups()
            located.append((match.start(), parse_field(typ, field, number, label == "repeated")))
        fields = [f for _, f in sorted(located, key=lambda item: item[0])]
        messages.append((name, fields))

    services: list[tuple[str, str]] = []
    for match in re.finditer(r"\bservice\s+(\w+)\s*\{(.*?)\}", text, re.S):
        service, body = match.groups()
        for method in re.findall(r"rpc\s+(\w+)\s*\(", body):
            services.append((service, method))
    return package_name, enums, messages, services


# --- FileDescriptorSet (protoc --descriptor_set_out) front-end -------------
# Field numbers per google/protobuf/descriptor.proto; decoded by hand, no deps.

def _pb_varint(data: bytes, pos: int) -> tuple[int, int]:
    value = 0
    shift = 0
    while pos < len(data) and shift <= 63:
        byte = data[pos]
        pos += 1
        value |= (byte & 0x7F) << shift
        if not (byte & 0x80):
            return value, pos
        shift += 7
    fail("malformed varint in descriptor set")


def _pb_fields(data: bytes) -> list[tuple[int, int, object]]:
    """Decode a protobuf blob into (field_number, wire_type, value) triples."""
    fields = []
    pos = 0
    while pos < len(data):
        key, pos = _pb_varint(data, pos)
        num, wire = key >> 3, key & 7
        if wire == 0:
            val, pos = _pb_varint(data, pos)
        elif wire == 1:
            val = data[pos:pos + 8]
            pos += 8
        elif wire == 2:
            ln, pos = _pb_varint(data, pos)
            val = data[pos:pos + ln]
            pos += ln
        elif wire == 5:
            val = data[pos:pos + 4]
            pos += 4
        else:
            fail(f"unsupported wire type {wire} in descriptor set")
        fields.append((num, wire, val))
    return fields


def _pb_str(fields: list, num: int, default: str = "") -> str:
    for n, w, v in fields:
        if n == num and w == 2:
            return v.decode("utf-8", errors="replace")
    return default


def _pb_int(fields: list, num: int, default: int = 0) -> int:
    for n, w, v in fields:
        if n == num and w == 0:
            # int32-ish values: negative numbers arrive sign-extended to 64 bits
            return v - (1 << 64) if v >= (1 << 63) else v
    return default


def _pb_has(fields: list, num: int) -> bool:
    return any(n == num for n, _, _ in fields)


def _pb_msgs(fields: list, num: int) -> list[list]:
    return [_pb_fields(v) for n, w, v in fields if n == num and w == 2]


_PB_TYPE_NAMES = {
    1: "double", 2: "float", 3: "int64", 4: "uint64", 5: "int32",
    6: "fixed64", 7: "fixed32", 8: "bool", 9: "string",
    13: "uint32", 15: "sfixed32", 16: "sfixed64", 17: "sint32", 18: "sint64",
}
_PB_LABEL_REPEATED = 3


def _model_from_descriptor(data: bytes) -> tuple:
    """Decode a FileDescriptorSet into (package, enums, messages, services).

    Nested message/enum definitions are flattened to Parent_Child names and
    fully-qualified type_name references (".pkg.Outer.Inner") are mapped onto
    them.  proto3 synthetic oneofs behind `optional` fields are folded back
    into plain singular fields.  Map entry structs feed map fields directly.
    """
    files = _pb_msgs(_pb_fields(data), 1)  # FileDescriptorSet.file
    if not files:
        fail("descriptor set contains no file")
    fdesc = files[0]
    package_name = _pb_str(fdesc, 2) or "proto"

    enums: list[tuple[str, list[tuple[str, int]]]] = []
    messages: list[tuple[str, list[dict]]] = []
    type_map: dict[str, str] = {}     # ".pkg.Outer.Inner" -> "Outer_Inner"
    map_entries: dict[str, list] = {} # entry full name -> entry field list

    def full_name(chain: list[str]) -> str:
        return "." + package_name + "." + ".".join(chain) if package_name != "proto" \
            else "." + ".".join(chain)

    def flatten(msg: list, chain: list[str]) -> None:
        name = _pb_str(msg, 1)
        local = "_".join(chain + [name])
        type_map[full_name(chain + [name])] = local

        is_map_entry = False
        for opt in _pb_msgs(msg, 7):  # DescriptorProto.options
            if _pb_int(opt, 7):       # MessageOptions.map_entry
                is_map_entry = True
        raw_fields = _pb_msgs(msg, 2)  # DescriptorProto.field
        if is_map_entry:
            map_entries[full_name(chain + [name])] = raw_fields
            return

        oneof_names = [_pb_str(o, 1) for o in _pb_msgs(msg, 8)]  # oneof_decl
        fields: list[dict] = []
        for fd in raw_fields:  # FieldDescriptorProto
            fields.append({"name": _pb_str(fd, 1), "number": _pb_int(fd, 3),
                           "label": _pb_int(fd, 4), "pb_type": _pb_int(fd, 5),
                           "type_name": _pb_str(fd, 6),
                           "oneof": (oneof_names[_pb_int(fd, 9)]
                                     if _pb_has(fd, 9) and not _pb_int(fd, 17)
                                     and _pb_int(fd, 9) < len(oneof_names) else None),
                           "raw": fd})
        messages.append((local, fields))

        for sub in _pb_msgs(msg, 3):  # nested_type
            flatten(sub, chain + [name])
        for enum in _pb_msgs(msg, 4):  # enum_type nested in a message
            flatten_enum(enum, chain + [name])

    def flatten_enum(enum: list, chain: list[str]) -> None:
        name = _pb_str(enum, 1)
        local = "_".join(chain + [name])
        type_map[full_name(chain + [name])] = local
        values = [(_pb_str(v, 1), _pb_int(v, 2)) for v in _pb_msgs(enum, 2)]
        enums.append((local, values))

    for enum in _pb_msgs(fdesc, 5):  # FileDescriptorProto.enum_type
        flatten_enum(enum, [])
    for msg in _pb_msgs(fdesc, 4):   # FileDescriptorProto.message_type
        flatten(msg, [])

    enum_names = {name for name, _ in enums}
    message_names = {name for name, _ in messages}

    def classify(typ: str) -> str:
        return ("scalar" if typ in PROTO_SCALAR else
                "enum" if typ in enum_names else
                "message" if typ in message_names else "unsupported")

    def field_proto_type(fd: dict) -> str:
        if fd["pb_type"] in (11, 14):  # MESSAGE / ENUM: resolve type_name
            local = type_map.get(fd["type_name"])
            if local:
                return local
            return fd["type_name"].split(".")[-1]
        return _PB_TYPE_NAMES.get(fd["pb_type"], f"unknown_type_{fd['pb_type']}")

    def entry_field_type(entry_fd: list) -> str:
        pb_type = _pb_int(entry_fd, 5)
        if pb_type in (11, 14):
            type_name = _pb_str(entry_fd, 6)
            return type_map.get(type_name) or type_name.split(".")[-1]
        return _PB_TYPE_NAMES.get(pb_type, f"unknown_type_{pb_type}")

    final_messages: list[tuple[str, list[dict]]] = []
    for name, raw_fields in messages:
        fields = []
        for fd in raw_fields:
            repeated = fd["label"] == _PB_LABEL_REPEATED
            entry = map_entries.get(fd["type_name"]) if fd["pb_type"] == 11 else None
            if repeated and entry is not None and len(entry) >= 2:
                # map<K,V>: key/value come from the entry's fields 1 and 2
                ktyp = entry_field_type(entry[0])
                vtyp = entry_field_type(entry[1])
                key_kind, val_kind = classify(ktyp), classify(vtyp)
                entry_name = "".join(part.capitalize() for part in fd["name"].split("_")) + "Entry"
                fields.append({"type": f"map<{ktyp},{vtyp}>", "name": fd["name"],
                               "number": fd["number"], "repeated": False, "oneof": None,
                               "entry": entry_name, "key_type": ktyp, "val_type": vtyp,
                               "key_kind": key_kind, "val_kind": val_kind,
                               "kind": ("map" if key_kind == "scalar" and
                                        ktyp not in ("float", "double", "fixed32", "fixed64",
                                                     "sfixed32", "sfixed64")
                                        and val_kind != "unsupported" else "unsupported")})
                continue
            typ = field_proto_type(fd)
            fields.append({"type": typ, "name": fd["name"], "number": fd["number"],
                           "repeated": repeated, "kind": classify(typ),
                           "oneof": fd["oneof"]})
        final_messages.append((name, fields))

    services: list[tuple[str, str]] = []
    for svc in _pb_msgs(fdesc, 6):  # FileDescriptorProto.service
        for mtd in _pb_msgs(svc, 2):  # ServiceDescriptorProto.method
            services.append((_pb_str(svc, 1), _pb_str(mtd, 1)))
    return package_name, enums, final_messages, services


def generate_proto(source: Path, output: Path, descriptor: bool | None = None) -> None:
    """Generate a small, dependency-free C model/encoder/decoder from a proto file.

    Input is either proto source text or a binary FileDescriptorSet produced
    by `protoc --descriptor_set_out` (auto-detected, or forced with
    --descriptor-set).  Covers scalar fields (varints plus
    fixed32/fixed64/sfixed32/sfixed64 and float/double), repeated fields
    (packed varints, packed fixed-width, and length-delimited), message-typed
    fields, oneof blocks (tagged union with a `_case` discriminator enum), map
    fields (repeated entry structs), enums (proto3 open semantics: unknown
    values are preserved), proto2-style optional/required labels (treated as
    plain singular fields), and service method paths.  Descriptor input also
    flattens nested type definitions; text input does not.  Unsupported field
    types stay visible as comments instead of silently producing incorrect
    wire encoders.
    """
    raw = source.read_bytes()
    if descriptor is None:
        # Auto-detect: descriptor sets are binary; proto sources are UTF-8 text
        # whose first meaningful token is a keyword.
        descriptor = source.suffix in (".pb", ".fds", ".bin")
        if not descriptor:
            try:
                head = raw[:4096].decode("utf-8")
                descriptor = not re.search(r"\b(syntax|package|message|enum|service)\b", head)
            except UnicodeDecodeError:
                descriptor = True
    if descriptor:
        package_name, enums, messages, services = _model_from_descriptor(raw)
    else:
        package_name, enums, messages, services = _model_from_proto_text(
            raw.decode("utf-8"))
    prefix = re.sub(r"\W+", "_", package_name)

    def wire_of(f: dict) -> str:
        if f["kind"] == "enum":
            return "varint"
        return PROTO_WIRE.get(f["type"], "varint")

    def oneof_groups(fields: list[dict]) -> list[tuple[str, list[dict]]]:
        order: list[str] = []
        groups: dict[str, list[dict]] = {}
        for f in fields:
            if f["oneof"]:
                if f["oneof"] not in groups:
                    groups[f["oneof"]] = []
                    order.append(f["oneof"])
                groups[f["oneof"]].append(f)
        return [(oname, groups[oname]) for oname in order]

    lines = ["/* Generated by cwist proto; do not edit. */", "#pragma once",
             "#include <cwist/net/grpc/protobuf.h>", "#include <stdint.h>", "#include <stddef.h>",
             "#include <stdlib.h>", "#include <string.h>", ""]

    for name, values in enums:
        cname = f"{prefix}_{name}"
        lines.append(f"typedef enum {cname} {{")
        for value, number in values:
            lines.append(f"    {prefix}_{name}_{value} = {number},")
        lines.extend([f"}} {cname};", ""])

    for name, _ in messages:
        lines.append(f"typedef struct {prefix}_{name} {prefix}_{name};")
    lines.append("")

    def ctype_of(f: dict) -> str:
        if f["kind"] == "scalar":
            return PROTO_SCALAR[f["type"]][0]
        return f"{prefix}_{f['type']}"

    for name, fields in messages:
        cname = f"{prefix}_{name}"
        for oname, ofields in oneof_groups(fields):
            lines.append(f"typedef enum {cname}_{oname}_case {{")
            lines.append(f"    {cname}_{oname}_CASE_NONE = 0,")
            for f in ofields:
                lines.append(f"    {cname}_{oname}_CASE_{f['name']} = {f['number']},")
            lines.extend([f"}} {cname}_{oname}_case;", ""])
        for f in fields:
            if f["kind"] != "map":
                continue
            key_ctype = PROTO_SCALAR[f["key_type"]][0]
            val_ctype = ctype_of({"kind": f["val_kind"], "type": f["val_type"]})
            lines.append(f"typedef struct {cname}_{f['entry']} {{")
            lines.append(f"    {key_ctype}{'' if key_ctype.endswith('*') else ' '}key;")
            if f["val_kind"] == "message":
                lines.append(f"    {val_ctype} *value;")
            else:
                lines.append(f"    {val_ctype}{'' if val_ctype.endswith('*') else ' '}value;")
            lines.extend([f"}} {cname}_{f['entry']};", ""])

    for name, fields in messages:
        cname = f"{prefix}_{name}"
        groups = oneof_groups(fields)
        lines.append(f"struct {cname} {{")
        emitted_oneofs: set[str] = set()
        for f in fields:
            typ, field = f["type"], f["name"]
            if f["kind"] == "map":
                lines.append(f"    {cname}_{f['entry']} *{field}; /* map */")
                lines.append(f"    size_t {field}_count;")
                continue
            if f["oneof"]:
                oname = f["oneof"]
                if oname in emitted_oneofs:
                    continue
                emitted_oneofs.add(oname)
                ofields = next(g for o, g in groups if o == oname)
                lines.append(f"    {cname}_{oname}_case {oname}_case;")
                lines.append("    union {")
                for of in ofields:
                    if of["kind"] == "unsupported":
                        lines.append(f"        /* {of['name']}: unsupported proto field type {of['type']}; handle it manually. */")
                    elif of["kind"] == "message":
                        lines.append(f"        {prefix}_{of['type']} *{of['name']};")
                    else:
                        ctype = ctype_of(of)
                        lines.append(f"        {ctype}{'' if ctype.endswith('*') else ' '}{of['name']};")
                lines.append(f"    }} {oname};")
                continue
            if f["kind"] == "scalar":
                ctype = PROTO_SCALAR[typ][0]
            elif f["kind"] == "enum":
                ctype = f"{prefix}_{typ}"
            elif f["kind"] == "message":
                ctype = f"{prefix}_{typ}"
            else:
                lines.append(f"    /* {field}: unsupported proto field type {typ}; handle it manually. */")
                continue
            if f["repeated"]:
                stars = "**" if ctype.endswith("*") else "*"
                lines.append(f"    {ctype.rstrip(' *')} {stars}{field}; /* repeated */")
                lines.append(f"    size_t {field}_count;")
            elif f["kind"] == "message":
                lines.append(f"    {ctype} *{field};")
            else:
                lines.append(f"    {ctype}{'' if ctype.endswith('*') else ' '}{field};")
        lines.extend(["};", ""])

    def cvalue(f: dict, expr: str) -> str:
        if f["kind"] == "scalar" and PROTO_SCALAR[f["type"]][2]:
            return f"(int64_t)cwist_pb_zigzag_encode({expr})"
        if f["kind"] == "enum":
            return f"(uint64_t){expr}"
        return expr

    def packed_write(f: dict, value: str) -> str:
        """Return the per-element write call used inside a packed sub-writer."""
        wire = wire_of(f)
        if wire == "32":
            bits = f"cwist_pb_float_bits({value})" if f["type"] == "float" else f"(uint32_t){value}"
            return f"cwist_pb_write_raw32(&sub, {bits})"
        if wire == "64":
            bits = f"cwist_pb_double_bits({value})" if f["type"] == "double" else f"(uint64_t){value}"
            return f"cwist_pb_write_raw64(&sub, {bits})"
        return f"cwist_pb_write_varint(&sub, (uint64_t){cvalue(f, value)})"

    def fixed_decode_expr(f: dict, src: str) -> str:
        """Decode a fixed-width scalar from little-endian raw bytes at `src`."""
        if f["type"] == "float":
            return f"cwist_pb_load_float({src})"
        if f["type"] == "double":
            return f"cwist_pb_load_double({src})"
        loader = "cwist_pb_load32_le" if wire_of(f) == "32" else "cwist_pb_load64_le"
        return f"({ctype_of(f)}){loader}({src})"

    def decode_scalar(f: dict, target: str, indent: str, var: str = "field") -> list[str]:
        wire = wire_of(f)
        if wire in ("32", "64"):
            tag = "CWIST_PB_32BIT" if wire == "32" else "CWIST_PB_64BIT"
            return [f"{indent}if ({var}.wire_type != {tag}) return -1;",
                    f"{indent}{target} = {fixed_decode_expr(f, var + '.bytes')};"]
        expr = f"{var}.varint"
        if f["kind"] == "scalar" and PROTO_SCALAR[f["type"]][2]:
            expr = f"cwist_pb_zigzag_decode({expr})"
        cast = f"({PROTO_SCALAR[f['type']][0]})" if f["kind"] == "scalar" else f"({prefix}_{f['type']})"
        return [f"{indent}if ({var}.wire_type != CWIST_PB_VARINT) return -1;",
                f"{indent}{target} = {cast}{expr};"]

    def decode_string(target: str, indent: str, var: str = "field") -> list[str]:
        return [f"{indent}if ({var}.wire_type != CWIST_PB_LEN) return -1;",
                f"{indent}{{",
                f"{indent}    char *copy = (char *)malloc({var}.len + 1);",
                f"{indent}    if (!copy) return -1;",
                f"{indent}    memcpy(copy, {var}.bytes, {var}.len); copy[{var}.len] = '\\0';",
                f"{indent}    free((void *){target}); {target} = copy;",
                f"{indent}}}"]

    def decode_message(typ: str, target: str, indent: str, var: str = "field") -> list[str]:
        return [f"{indent}if ({var}.wire_type != CWIST_PB_LEN) return -1;",
                f"{indent}{{",
                f"{indent}    {prefix}_{typ} *sub = ({prefix}_{typ} *)calloc(1, sizeof(*sub));",
                f"{indent}    if (!sub) return -1;",
                f"{indent}    cwist_pb_reader sr;",
                f"{indent}    cwist_pb_reader_init(&sr, {var}.bytes, {var}.len);",
                f"{indent}    if ({prefix}_{typ}_decode(&sr, sub) != 0) {{ free(sub); return -1; }}",
                f"{indent}    if ({target}) {{ {prefix}_{typ}_free({target}); free({target}); }}",
                f"{indent}    {target} = sub;",
                f"{indent}}}"]

    def encode_value(f: dict, number: int, expr: str, indent: str) -> list[str]:
        """Encode one scalar/enum/message value expression as field `number`."""
        if f["kind"] == "enum":
            return [f"{indent}if (cwist_pb_write_uint64_field(w, {number}, (uint64_t){expr}) != 0) return -1;"]
        if f["kind"] == "scalar":
            if f["type"] == "string":
                return [f"{indent}if ({expr}) {{ " + _gen_scalar_encode(str(number), f["type"], expr) + " }"]
            return [f"{indent}" + _gen_scalar_encode(str(number), f["type"], expr)]
        return [f"{indent}if ({expr}) {{",
                f"{indent}    cwist_pb_writer sub;",
                f"{indent}    cwist_pb_writer_init(&sub);",
                f"{indent}    if ({prefix}_{f['type']}_encode(&sub, {expr}) != 0) {{ cwist_pb_writer_free(&sub); return -1; }}",
                f"{indent}    int rc = cwist_pb_write_bytes_field(w, {number}, sub.data, sub.len);",
                f"{indent}    cwist_pb_writer_free(&sub);",
                f"{indent}    if (rc != 0) return -1;",
                f"{indent}}}"]

    def map_entry_clear(f: dict, expr: str, indent: str) -> list[str]:
        out = []
        if f["key_kind"] == "scalar" and f["key_type"] == "string":
            out.append(f"{indent}free((void *){expr}.key);")
        if f["val_kind"] == "scalar" and f["val_type"] == "string":
            out.append(f"{indent}free((void *){expr}.value);")
        elif f["val_kind"] == "message":
            out.append(f"{indent}if ({expr}.value) {{ {prefix}_{f['val_type']}_free({expr}.value); free({expr}.value); }}")
        return out

    for name, fields in messages:
        cname = f"{prefix}_{name}"
        groups = oneof_groups(fields)
        # Append helpers keep repeated-field growth in one place per field.
        for f in fields:
            if f["kind"] == "map":
                field = f["name"]
                lines.extend([
                    f"static inline int {cname}__append_{field}({cname} *m, const {cname}_{f['entry']} *value) {{",
                    f"    void *next = realloc(m->{field}, (m->{field}_count + 1) * sizeof(*m->{field}));",
                    "    if (!next) return -1;",
                    f"    m->{field} = ({cname}_{f['entry']} *)next;",
                    f"    m->{field}[m->{field}_count++] = *value;",
                    "    return 0;",
                    "}", ""])
                continue
            if not f["repeated"] or f["kind"] == "unsupported" or f["oneof"]:
                continue
            typ, field = f["type"], f["name"]
            if f["kind"] == "scalar":
                ctype = PROTO_SCALAR[typ][0]
            else:
                ctype = f"{prefix}_{typ}"
            if f["kind"] == "message":
                lines.extend([
                    f"static inline int {cname}__append_{field}({cname} *m, const {ctype} *value) {{",
                    f"    void *next = realloc(m->{field}, (m->{field}_count + 1) * sizeof(*m->{field}));",
                    "    if (!next) return -1;",
                    f"    m->{field} = ({ctype} *)next;",
                    f"    m->{field}[m->{field}_count++] = *value;",
                    "    return 0;",
                    "}", ""])
            else:
                lines.extend([
                    f"static inline int {cname}__append_{field}({cname} *m, {ctype} value) {{",
                    f"    void *next = realloc(m->{field}, (m->{field}_count + 1) * sizeof(*m->{field}));",
                    "    if (!next) return -1;",
                    f"    m->{field} = ({ctype.rstrip(' *')} {'**' if ctype.endswith('*') else '*'})next;",
                    f"    m->{field}[m->{field}_count++] = value;",
                    "    return 0;",
                    "}", ""])

        for oname, ofields in groups:
            lines.append(f"static inline void {cname}__clear_{oname}({cname} *m) {{")
            lines.append(f"    switch (m->{oname}_case) {{")
            for of in ofields:
                if of["kind"] == "scalar" and of["type"] == "string":
                    lines.append(f"    case {cname}_{oname}_CASE_{of['name']}:")
                    lines.append(f"        free((void *)m->{oname}.{of['name']});")
                    lines.append("        break;")
                elif of["kind"] == "message":
                    lines.append(f"    case {cname}_{oname}_CASE_{of['name']}:")
                    lines.append(f"        if (m->{oname}.{of['name']}) {{ {prefix}_{of['type']}_free(m->{oname}.{of['name']}); free(m->{oname}.{of['name']}); }}")
                    lines.append("        break;")
            lines.extend(["    default:", "        break;", "    }",
                          f"    m->{oname}_case = {cname}_{oname}_CASE_NONE;",
                          f"    memset(&m->{oname}, 0, sizeof(m->{oname}));",
                          "}", ""])

        lines.extend([f"static inline int {cname}_encode(cwist_pb_writer *w, const {cname} *m) {{",
                      "    if (!w || !m) return -1;"])
        emitted_oneofs = set()
        for f in fields:
            typ, field, number = f["type"], f["name"], f["number"]
            if f["kind"] == "unsupported":
                lines.append(f"    /* {field}: unsupported proto field type {typ}; supply a custom encoder. */")
            elif f["kind"] == "map":
                key_f = {"kind": f["key_kind"], "type": f["key_type"]}
                val_f = {"kind": f["val_kind"], "type": f["val_type"]}
                lines.extend([
                    f"    for (size_t i = 0; i < m->{field}_count; i++) {{",
                    "        cwist_pb_writer sub;",
                    "        cwist_pb_writer_init(&sub);",
                    f"        const {cname}_{f['entry']} *e = &m->{field}[i];"])
                # key/value encodes target the entry sub-writer; on failure free it
                def sub_encode(vf: dict, vnum: int, expr: str) -> list[str]:
                    def to_sub(stmt: str) -> str:
                        return stmt.replace("(w, ", "(&sub, ", 1).replace(
                            "return -1;", "{ cwist_pb_writer_free(&sub); return -1; }")
                    if vf["kind"] == "scalar":
                        stmt = to_sub(_gen_scalar_encode(str(vnum), vf["type"], expr))
                        if vf["type"] == "string":
                            return [f"        if ({expr}) {{ {stmt} }}"]
                        return [f"        {stmt}"]
                    if vf["kind"] == "enum":
                        return [f"        if (cwist_pb_write_uint64_field(&sub, {vnum}, (uint64_t){expr}) != 0) {{ cwist_pb_writer_free(&sub); return -1; }}"]
                    return [
                        f"        if ({expr}) {{",
                        "            cwist_pb_writer vw;",
                        "            cwist_pb_writer_init(&vw);",
                        f"            if ({prefix}_{vf['type']}_encode(&vw, {expr}) != 0) {{ cwist_pb_writer_free(&vw); cwist_pb_writer_free(&sub); return -1; }}",
                        f"            int vrc = cwist_pb_write_bytes_field(&sub, {vnum}, vw.data, vw.len);",
                        "            cwist_pb_writer_free(&vw);",
                        "            if (vrc != 0) { cwist_pb_writer_free(&sub); return -1; }",
                        "        }"]
                lines.extend(sub_encode(key_f, 1, "e->key"))
                lines.extend(sub_encode(val_f, 2, "e->value"))
                lines.extend([
                    f"        int rc = cwist_pb_write_bytes_field(w, {number}, sub.data, sub.len);",
                    "        cwist_pb_writer_free(&sub);",
                    "        if (rc != 0) return -1;",
                    "    }"])
            elif f["oneof"]:
                oname = f["oneof"]
                if oname in emitted_oneofs:
                    continue
                emitted_oneofs.add(oname)
                ofields = next(g for o, g in groups if o == oname)
                lines.append(f"    switch (m->{oname}_case) {{")
                for of in ofields:
                    if of["kind"] == "unsupported":
                        continue
                    lines.append(f"    case {cname}_{oname}_CASE_{of['name']}:")
                    lines.extend(encode_value(of, of["number"], f"m->{oname}.{of['name']}", "        "))
                    lines.append("        break;")
                lines.extend(["    default:", "        break;", "    }"])
            elif f["kind"] == "scalar" and not f["repeated"]:
                if typ == "string":
                    lines.append(f"    if (m->{field}) {{ " + _gen_scalar_encode(str(number), typ, f"m->{field}") + " }")
                else:
                    lines.append("    " + _gen_scalar_encode(str(number), typ, f"m->{field}"))
            elif f["kind"] == "enum" and not f["repeated"]:
                lines.append(f"    if (cwist_pb_write_uint64_field(w, {number}, (uint64_t)m->{field}) != 0) return -1;")
            elif f["kind"] == "message" and not f["repeated"]:
                lines.extend([
                    f"    if (m->{field}) {{",
                    "        cwist_pb_writer sub;",
                    "        cwist_pb_writer_init(&sub);",
                    f"        if ({prefix}_{typ}_encode(&sub, m->{field}) != 0) {{ cwist_pb_writer_free(&sub); return -1; }}",
                    f"        int rc = cwist_pb_write_bytes_field(w, {number}, sub.data, sub.len);",
                    "        cwist_pb_writer_free(&sub);",
                    "        if (rc != 0) return -1;",
                    "    }"])
            elif f["repeated"] and f["kind"] in ("scalar", "enum"):
                if f["kind"] == "scalar" and typ == "string":
                    lines.extend([
                        f"    for (size_t i = 0; i < m->{field}_count; i++)",
                        f"        if (m->{field}[i]) {{ " + _gen_scalar_encode(str(number), typ, f"m->{field}[i]") + " }"])
                elif wire_of(f) in ("32", "64"):  # packed fixed-width numerics
                    lines.extend([
                        f"    if (m->{field}_count > 0) {{",
                        "        cwist_pb_writer sub;",
                        "        cwist_pb_writer_init(&sub);",
                        f"        for (size_t i = 0; i < m->{field}_count; i++)",
                        f"            if ({packed_write(f, f'm->{field}[i]')} != 0) {{ cwist_pb_writer_free(&sub); return -1; }}",
                        f"        int rc = cwist_pb_write_bytes_field(w, {number}, sub.data, sub.len);",
                        "        cwist_pb_writer_free(&sub);",
                        "        if (rc != 0) return -1;",
                        "    }"])
                else:  # packed varints (proto3 default for repeated numerics)
                    value = cvalue(f, f"m->{field}[i]")
                    lines.extend([
                        f"    if (m->{field}_count > 0) {{",
                        "        cwist_pb_writer sub;",
                        "        cwist_pb_writer_init(&sub);",
                        f"        for (size_t i = 0; i < m->{field}_count; i++)",
                        f"            if (cwist_pb_write_varint(&sub, (uint64_t){value}) != 0) {{ cwist_pb_writer_free(&sub); return -1; }}",
                        f"        int rc = cwist_pb_write_bytes_field(w, {number}, sub.data, sub.len);",
                        "        cwist_pb_writer_free(&sub);",
                        "        if (rc != 0) return -1;",
                        "    }"])
            else:  # repeated message
                lines.extend([
                    f"    for (size_t i = 0; i < m->{field}_count; i++) {{",
                    "        cwist_pb_writer sub;",
                    "        cwist_pb_writer_init(&sub);",
                    f"        if ({prefix}_{typ}_encode(&sub, &m->{field}[i]) != 0) {{ cwist_pb_writer_free(&sub); return -1; }}",
                    f"        int rc = cwist_pb_write_bytes_field(w, {number}, sub.data, sub.len);",
                    "        cwist_pb_writer_free(&sub);",
                    "        if (rc != 0) return -1;",
                    "    }"])
        lines.extend(["    return 0;", "}", ""])

        lines.extend([f"static inline int {cname}_decode(cwist_pb_reader *r, {cname} *m) {{",
                      "    if (!r || !m) return -1;",
                      "    cwist_pb_field field;",
                      "    while (cwist_pb_read_field(r, &field) > 0) {",
                      "        switch (field.number) {"])
        for f in fields:
            typ, field, number = f["type"], f["name"], f["number"]
            if f["kind"] == "unsupported":
                continue
            lines.append(f"        case {number}:")
            if f["kind"] == "map":
                key_f = {"kind": f["key_kind"], "type": f["key_type"]}
                val_f = {"kind": f["val_kind"], "type": f["val_type"]}
                lines.extend([
                    "            if (field.wire_type != CWIST_PB_LEN) return -1;",
                    "            {",
                    f"                {cname}_{f['entry']} e;",
                    "                memset(&e, 0, sizeof(e));",
                    "                cwist_pb_reader sr;",
                    "                cwist_pb_reader_init(&sr, field.bytes, field.len);",
                    "                cwist_pb_field kv;",
                    "                while (cwist_pb_read_field(&sr, &kv) > 0) {",
                    "                    if (kv.number == 1) {"])
                if f["key_kind"] == "scalar" and f["key_type"] == "string":
                    lines.extend(decode_string("e.key", "                        ", "kv"))
                else:
                    lines.extend(decode_scalar(key_f, "e.key", "                        ", "kv"))
                lines.append("                    } else if (kv.number == 2) {")
                if f["val_kind"] == "scalar" and f["val_type"] == "string":
                    lines.extend(decode_string("e.value", "                        ", "kv"))
                elif f["val_kind"] == "message":
                    lines.extend(decode_message(f["val_type"], "e.value", "                        ", "kv"))
                else:
                    lines.extend(decode_scalar(val_f, "e.value", "                        ", "kv"))
                lines.extend(["                    }",
                              "                }"])
                cleanup = map_entry_clear(f, "e", " " * 20)
                if cleanup:
                    lines.append(f"                if ({cname}__append_{field}(m, &e) != 0) {{")
                    lines.extend(cleanup)
                    lines.append("                    return -1;")
                    lines.append("                }")
                else:
                    lines.append(f"                if ({cname}__append_{field}(m, &e) != 0) return -1;")
                lines.append("            }")
            elif f["oneof"]:
                oname = f["oneof"]
                lines.append(f"            {cname}__clear_{oname}(m);")
                if f["kind"] == "scalar" and typ == "string":
                    lines.extend(decode_string(f"m->{oname}.{field}", "            "))
                elif f["kind"] == "message":
                    lines.extend(decode_message(typ, f"m->{oname}.{field}", "            "))
                else:
                    lines.extend(decode_scalar(f, f"m->{oname}.{field}", "            "))
                lines.append(f"            m->{oname}_case = {cname}_{oname}_CASE_{field};")
            elif f["kind"] == "scalar" and not f["repeated"] and typ == "string":
                lines.extend(decode_string(f"m->{field}", "            "))
            elif not f["repeated"] and f["kind"] in ("scalar", "enum"):
                lines.extend(decode_scalar(f, f"m->{field}", "            "))
            elif f["kind"] == "message" and not f["repeated"]:
                lines.extend(decode_message(typ, f"m->{field}", "            "))
            elif f["repeated"] and f["kind"] in ("scalar", "enum") and not (f["kind"] == "scalar" and typ == "string"):
                ctype = PROTO_SCALAR[typ][0] if f["kind"] == "scalar" else f"{prefix}_{typ}"
                wire = wire_of(f)
                if wire in ("32", "64"):
                    width = "4" if wire == "32" else "8"
                    tag = "CWIST_PB_32BIT" if wire == "32" else "CWIST_PB_64BIT"
                    lines.append("            if (field.wire_type == CWIST_PB_LEN) { /* packed */")
                    lines.append(f"                if (field.len % {width} != 0) return -1;")
                    lines.append("                const uint8_t *p = field.bytes;")
                    lines.append("                const uint8_t *end = field.bytes + field.len;")
                    lines.append("                while (p < end) {")
                    lines.append(f"                    {{ {ctype} item = {fixed_decode_expr(f, 'p')};")
                    lines.append(f"                      if ({cname}__append_{field}(m, item) != 0) return -1; }}")
                    lines.append(f"                    p += {width};")
                    lines.append("                }")
                    lines.append(f"            }} else if (field.wire_type == {tag}) {{")
                    lines.append(f"                {{ {ctype} item = {fixed_decode_expr(f, 'field.bytes')};")
                    lines.append(f"                  if ({cname}__append_{field}(m, item) != 0) return -1; }}")
                    lines.append("            } else return -1;")
                else:
                    lines.append("            if (field.wire_type == CWIST_PB_LEN) { /* packed */")
                    lines.append("                cwist_pb_reader sr;")
                    lines.append("                cwist_pb_reader_init(&sr, field.bytes, field.len);")
                    lines.append("                uint64_t v;")
                    lines.append("                while (sr.pos < sr.len) {")
                    lines.append("                    if (cwist_pb_read_varint(&sr, &v) != 0) return -1;")
                    expr = "cwist_pb_zigzag_decode(v)" if f["kind"] == "scalar" and PROTO_SCALAR[typ][2] else "v"
                    lines.append(f"                    {{ {ctype} item = ({ctype}){expr};")
                    lines.append(f"                      if ({cname}__append_{field}(m, item) != 0) return -1; }}")
                    lines.append("                }")
                    lines.append("            } else if (field.wire_type == CWIST_PB_VARINT) {")
                    expr = "cwist_pb_zigzag_decode(field.varint)" if f["kind"] == "scalar" and PROTO_SCALAR[typ][2] else "field.varint"
                    lines.append(f"                {{ {ctype} item = ({ctype}){expr};")
                    lines.append(f"                  if ({cname}__append_{field}(m, item) != 0) return -1; }}")
                    lines.append("            } else return -1;")
            elif f["repeated"] and f["kind"] == "scalar" and typ == "string":
                lines.extend([
                    "            if (field.wire_type != CWIST_PB_LEN) return -1;",
                    "            {",
                    "                char *copy = (char *)malloc(field.len + 1);",
                    "                if (!copy) return -1;",
                    "                memcpy(copy, field.bytes, field.len); copy[field.len] = '\\0';",
                    f"                if ({cname}__append_{field}(m, copy) != 0) {{ free(copy); return -1; }}",
                    "            }"])
            else:  # repeated message
                lines.extend([
                    "            if (field.wire_type != CWIST_PB_LEN) return -1;",
                    "            {",
                    f"                {prefix}_{typ} item;",
                    "                memset(&item, 0, sizeof(item));",
                    "                cwist_pb_reader sr;",
                    "                cwist_pb_reader_init(&sr, field.bytes, field.len);",
                    f"                if ({prefix}_{typ}_decode(&sr, &item) != 0) {{ {prefix}_{typ}_free(&item); return -1; }}",
                    f"                if ({cname}__append_{field}(m, &item) != 0) {{ {prefix}_{typ}_free(&item); return -1; }}",
                    "            }"])
            lines.append("            break;")
        lines.extend(["        default: /* unknown field: already consumed by cwist_pb_read_field */",
                      "            break;",
                      "        }",
                      "    }",
                      "    return 0;",
                      "}", ""])

        lines.extend([f"static inline void {cname}_free({cname} *m) {{",
                      "    if (!m) return;"])
        for f in fields:
            typ, field = f["type"], f["name"]
            if f["kind"] == "unsupported":
                continue
            if f["kind"] == "map":
                clear = map_entry_clear(f, f"m->{field}[i]", "        ")
                if clear:
                    lines.append(f"    for (size_t i = 0; i < m->{field}_count; i++) {{")
                    lines.extend(clear)
                    lines.append("    }")
                lines.append(f"    free(m->{field});")
            elif f["oneof"]:
                pass  # released through the clear helpers below
            elif f["repeated"]:
                if f["kind"] == "scalar" and typ == "string":
                    lines.append(f"    for (size_t i = 0; i < m->{field}_count; i++) free((void *)m->{field}[i]);")
                    lines.append(f"    free(m->{field});")
                elif f["kind"] == "message":
                    lines.append(f"    for (size_t i = 0; i < m->{field}_count; i++) {prefix}_{typ}_free(&m->{field}[i]);")
                    lines.append(f"    free(m->{field});")
                else:
                    lines.append(f"    free(m->{field});")
            elif f["kind"] == "scalar" and typ == "string":
                lines.append(f"    free((void *)m->{field});")
            elif f["kind"] == "message":
                lines.append(f"    if (m->{field}) {{ {prefix}_{typ}_free(m->{field}); free(m->{field}); }}")
        for oname, _ in groups:
            lines.append(f"    {cname}__clear_{oname}(m);")
        lines.extend(["    memset(m, 0, sizeof(*m));", "}", ""])

    for service, method in services:
        lines.append(f'#define {prefix}_{service}_{method}_PATH "/{package_name}.{service}/{method}"')
    output.parent.mkdir(parents=True, exist_ok=True)
    output.write_text("\n".join(lines) + "\n", encoding="utf-8")
    print(f"wrote {output}")


def project_file(value: str | None) -> Path:
    if value:
        matches = list(Path.cwd().glob(value))
        if len(matches) != 1: fail("--project must identify exactly one .cwpro file")
        return matches[0]
    matches = list(Path.cwd().glob("*.cwpro"))
    if len(matches) != 1: fail("run in a project directory or pass --project")
    return matches[0]


def _is_excluded(path: Path, root: Path, exclude: list[str]) -> bool:
    """True when path sits under an excluded root-relative directory prefix."""
    if not exclude:
        return False
    try:
        parts = path.relative_to(root).parts
    except ValueError:
        return False
    for entry in exclude:
        prefix = Path(entry).parts
        if prefix and parts[:len(prefix)] == prefix:
            return True
    return False


def watched_files(root: Path, exclude: list[str] | None = None) -> dict[Path, int]:
    """Return source and build-description mtimes, excluding generated output."""
    names = {"Makefile", "makefile", "GNUmakefile"}
    return {path: path.stat().st_mtime_ns for path in root.rglob("*")
            if path.is_file() and (path.suffix in {".c", ".h", ".cwpro"} or path.name in names)
            and ".cwist-build" not in path.parts and "bin" not in path.parts
            and not _is_excluded(path, root, exclude or [])}


def impacted_sources(root: Path, changed: set[Path], exclude: list[str] | None = None) -> set[Path]:
    """Return C translation units affected through local quoted includes."""
    files = watched_files(root, exclude)
    reverse: dict[Path, set[Path]] = {}
    include = re.compile(r'^\s*#\s*include\s+"([^"]+)"')
    for path in files:
        for line in path.read_text(encoding="utf-8", errors="ignore").splitlines():
            found = include.match(line)
            if found:
                target = (path.parent / found.group(1)).resolve()
                reverse.setdefault(target, set()).add(path.resolve())
    queue = [path.resolve() for path in changed]
    affected = set(queue)
    while queue:
        current = queue.pop()
        for parent in reverse.get(current, set()):
            if parent not in affected: affected.add(parent); queue.append(parent)
    return {path for path in affected if path.suffix == ".c"}


class FileEventSource:
    """Event-first watcher with an mtime snapshot fallback.

    The snapshot remains authoritative: kernel events are only a low-latency
    wake-up signal, so overflow, dropped events, and newly-created directories
    cannot cause a missed rebuild.
    """
    _IN_MASK = 0x00000002 | 0x00000008 | 0x00000040 | 0x00000080 | 0x00000100 | 0x00000200
    _SKIP = {".git", "bin", "build", ".cwist-build", "node_modules", "__pycache__"}

    def __init__(self, root: Path, force_poll: bool = False, exclude: list[str] | None = None) -> None:
        self.root = root
        self.exclude = exclude or []
        self.fd = -1
        self.kq = None
        self.open_fds: list[int] = []
        self.backend = "poll"
        if not force_poll and sys.platform.startswith("linux"):
            self._open_inotify()
        elif not force_poll and hasattr(select, "kqueue"):
            self._open_kqueue()

    def _directories(self) -> list[Path]:
        dirs = []
        for path in self.root.rglob("*"):
            if path.is_dir() and not any(part in self._SKIP for part in path.parts):
                if not _is_excluded(path, self.root, self.exclude):
                    dirs.append(path)
        return [self.root, *dirs]

    def _open_inotify(self) -> None:
        try:
            libc = ctypes.CDLL(None, use_errno=True)
            init = libc.inotify_init1
            init.argtypes, init.restype = [ctypes.c_int], ctypes.c_int
            self.fd = init(os.O_NONBLOCK | os.O_CLOEXEC)
            if self.fd < 0:
                return
            add = libc.inotify_add_watch
            add.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_uint32]
            add.restype = ctypes.c_int
            for directory in self._directories():
                add(self.fd, os.fsencode(directory), self._IN_MASK)
            self.backend = "inotify"
        except (AttributeError, OSError):
            self.close()

    def _open_kqueue(self) -> None:
        try:
            self.kq = select.kqueue()
            events = []
            flags = select.KQ_NOTE_WRITE | select.KQ_NOTE_DELETE | select.KQ_NOTE_RENAME | select.KQ_NOTE_EXTEND
            for directory in self._directories():
                fd = os.open(directory, os.O_RDONLY)
                self.open_fds.append(fd)
                events.append(select.kevent(fd, filter=select.KQ_FILTER_VNODE,
                                            flags=select.KQ_EV_ADD | select.KQ_EV_ENABLE | select.KQ_EV_CLEAR,
                                            fflags=flags))
            self.kq.control(events, 0, 0)
            self.backend = "kqueue"
        except (AttributeError, OSError):
            self.close()

    def wait(self, timeout: float) -> bool:
        if self.backend == "inotify" and self.fd >= 0:
            readable, _, _ = select.select([self.fd], [], [], timeout)
            if not readable:
                return False
            try:
                while os.read(self.fd, 65536):
                    pass
            except BlockingIOError:
                pass
            return True
        elif self.backend == "kqueue" and self.kq:
            return bool(self.kq.control(None, 1, timeout))
        else:
            time.sleep(timeout)
            return False

    def refresh(self) -> None:
        """Pick up recursively created source directories after a tree event."""
        backend = self.backend
        if backend == "poll":
            return
        self.close()
        if backend == "inotify":
            self._open_inotify()
        else:
            self._open_kqueue()

    def close(self) -> None:
        if self.fd >= 0:
            os.close(self.fd)
            self.fd = -1
        for fd in self.open_fds:
            os.close(fd)
        self.open_fds = []
        if self.kq:
            self.kq.close()
            self.kq = None
        self.backend = "poll"


class ProcessSupervisor:
    """Own the development child in a process group for reliable restarts."""

    def __init__(self, root: Path, command: str, timeout_ms: int) -> None:
        self.root, self.command = root, command
        self.timeout = max(timeout_ms, 100) / 1000
        self.child: subprocess.Popen | None = None

    def start(self) -> bool:
        if not self.command:
            return True
        try:
            self.child = subprocess.Popen(shlex.split(self.command), cwd=self.root,
                                          start_new_session=True)
            print(f"started: {self.command} (pid {self.child.pid})")
            return True
        except OSError as exc:
            print(f"could not start development process: {exc}", file=sys.stderr)
            self.child = None
            return False

    def stop(self) -> None:
        if not self.child or self.child.poll() is not None:
            return
        try:
            import os
            os.killpg(self.child.pid, signal.SIGTERM)
            self.child.wait(timeout=self.timeout)
        except subprocess.TimeoutExpired:
            import os
            os.killpg(self.child.pid, signal.SIGKILL)
            self.child.wait()
        finally:
            self.child = None

    def restart(self) -> bool:
        """Perform seamless overlap restart: spawn new process first then terminate old."""
        old_child = self.child
        try:
            new_child = subprocess.Popen(shlex.split(self.command), cwd=self.root,
                                         start_new_session=True)
            print(f"hot-swapped: started new process {self.command} (pid {new_child.pid})")
            self.child = new_child
            time.sleep(0.05)  # Brief overlap for SO_REUSEPORT binding transfer
        except OSError as exc:
            print(f"could not start new development process during hot swap: {exc}", file=sys.stderr)
            return False

        if old_child and old_child.poll() is None:
            try:
                import os
                os.killpg(old_child.pid, signal.SIGTERM)
                old_child.wait(timeout=self.timeout)
            except subprocess.TimeoutExpired:
                import os
                os.killpg(old_child.pid, signal.SIGKILL)
                old_child.wait()
            except Exception:
                pass
        return True


def watcher(project_arg: str | None, interval: float, once: bool, run: bool, force_poll: bool) -> bool:
    manifest_path = project_file(project_arg).resolve()
    manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
    if manifest.get("format") != FORMAT: fail("unsupported .cwpro format")
    root = manifest_path.parent
    source_root = root / manifest.get("openapi", {}).get("source", "src")
    watch_cfg = manifest.get("watch", {})
    exclude = watch_cfg.get("exclude", [])
    if not isinstance(exclude, list) or not all(isinstance(e, str) for e in exclude):
        fail("watch.exclude must be a list of root-relative directory paths")
    previous = watched_files(root, exclude)
    dev = manifest.get("dev", {})
    command = dev.get("command") or f"./{manifest.get('build', {}).get('binary', '')}"
    supervisor = ProcessSupervisor(root, command, int(dev.get("stop_timeout_ms", 5000)))
    events = FileEventSource(root, force_poll, exclude)
    debounce = max(int(dev.get("debounce_ms", 150)), 0) / 1000
    print(f"watching {source_root} ({events.backend}, interval {interval:.2f}s, hot reload {'on' if run else 'off'}"
          + (f", excluding {', '.join(exclude)}" if exclude else "") + ")")
    last_build_ok = True
    try:
        if run and not once and not supervisor.start():
            return False
        while True:
            if once:
                changed = {path for path in previous if path.suffix == ".c"}
            else:
                event_changed = events.wait(interval)
                current = watched_files(root, exclude)
                changed = {path for path in set(previous) | set(current) if previous.get(path) != current.get(path)}
                previous = current
                if event_changed:
                    events.refresh()
            if changed:
                # Coalesce editor atomic-save bursts before calculating the impact graph.
                if debounce and not once:
                    time.sleep(debounce)
                    current = watched_files(root, exclude)
                    changed |= {path for path in set(previous) | set(current)
                                if previous.get(path) != current.get(path)}
                    previous = current
                source_changes = {path for path in changed if path.suffix in {".c", ".h"}}
                scope = impacted_sources(root, source_changes, exclude) if source_changes else set()
                print("changed:", ", ".join(str(path.relative_to(root)) for path in sorted(changed)))
                print("recompile scope:", ", ".join(str(path.relative_to(root)) for path in sorted(scope)) or "build metadata")
                env = dict(__import__("os").environ)
                env["CWIST_CHANGED_SOURCES"] = ":".join(str(path.relative_to(root)) for path in sorted(scope))
                result = subprocess.run(shlex.split(manifest.get("build", {}).get("command", "make")),
                                        cwd=root, env=env)
                last_build_ok = result.returncode == 0
                if last_build_ok and run and not once:
                    supervisor.restart()
                elif not last_build_ok:
                    print(f"build failed ({result.returncode}); keeping the previous process", file=sys.stderr)
            if once: return last_build_ok
    except KeyboardInterrupt:
        print("stopping watcher")
        return last_build_ok
    finally:
        supervisor.stop()
        events.close()


def main() -> None:
    parser = argparse.ArgumentParser(prog="cwist")
    sub = parser.add_subparsers(dest="command", required=True)
    new = sub.add_parser("new", help="create a self-describing CWIST project")
    new.add_argument("kind", choices=["project"])
    new.add_argument("name")
    new.add_argument("--directory", type=Path)
    api = sub.add_parser("openapi", help="generate OpenAPI 3.1 from Doxygen route annotations")
    api.add_argument("source", type=Path)
    api.add_argument("--output", type=Path)
    api.add_argument("--project")
    api.add_argument("--title")
    api.add_argument("--version")
    proto = sub.add_parser("proto", help="generate C protobuf models and gRPC method paths from proto3 source or a protoc descriptor set")
    proto.add_argument("source", type=Path)
    proto.add_argument("--output", type=Path)
    proto.add_argument("--descriptor-set", action="store_true",
                       help="treat input as a binary FileDescriptorSet (protoc --descriptor_set_out); auto-detected otherwise")
    audit = sub.add_parser("audit", help="list allocation/pthread call sites by convention (cwist / gnu / bsd)")
    audit.add_argument("target", nargs="?", default=None,
                       help='a file/directory to scan (relative, absolute, or ~), recursively -- '
                            'OR a query string \'style:bsd;folder:./src/net\' (an optional leading '
                            '"open=" is accepted verbatim). Query keys: style, category (cat), '
                            'folder (path), json. Default: src')
    audit.add_argument("--category", choices=["all", *AUDIT_PATTERNS.keys()], default="all")
    audit.add_argument("--style", choices=["all", "cwist", "gnu", "bsd"], default="all")
    audit.add_argument("--json", action="store_true")
    describe = sub.add_parser("describe", help="print a .cwpro manifest")
    describe.add_argument("--project")
    watch = sub.add_parser("watcher", help="watch, incrementally rebuild, and hot-restart the development process")
    watch.add_argument("--project")
    watch.add_argument("--interval", type=float, default=0.5)
    watch.add_argument("--once", action="store_true")
    watch.add_argument("--no-run", action="store_true", help="rebuild only; do not start or restart the app")
    watch.add_argument("--poll", action="store_true", help="force polling instead of inotify/kqueue")
    args = parser.parse_args()
    if args.command == "new": write_new_project(args.name, args.directory)
    elif args.command == "proto":
        output = args.output or args.source.with_suffix(".cwist.pb.h")
        generate_proto(args.source, output,
                       True if args.descriptor_set else None)
    elif args.command == "audit":
        path, category, style, as_json = Path("src"), args.category, args.style, args.json
        if args.target is not None:
            if looks_like_audit_query(args.target):
                q = parse_audit_query(args.target)
                if "path" in q: path = Path(q["path"])
                if "category" in q:
                    if q["category"] not in ("all", *AUDIT_PATTERNS.keys()): fail(f"unknown category: {q['category']}")
                    category = q["category"]
                if "style" in q:
                    if q["style"] not in ("all", "cwist", "gnu", "bsd"): fail(f"unknown style: {q['style']}")
                    style = q["style"]
                if "json" in q: as_json = q["json"].strip().lower() in ("1", "true", "yes")
            else:
                path = Path(args.target)
        run_audit(path, category, style, as_json)
    elif args.command == "describe": print(json.dumps(json.loads(project_file(args.project).read_text()), indent=2))
    elif args.command == "watcher":
        if args.interval <= 0: fail("--interval must be positive")
        if not watcher(args.project, args.interval, args.once, not args.no_run, args.poll): raise SystemExit(1)
    else:
        config = {}
        if args.project or list(Path.cwd().glob("*.cwpro")):
            config = json.loads(project_file(args.project).read_text()).get("openapi", {})
        generate_openapi(args.source, args.output or Path(config.get("output", "openapi.json")),
                         args.title or config.get("title", "CWIST API"), args.version or config.get("version", "0.1.0"))


if __name__ == "__main__": main()
